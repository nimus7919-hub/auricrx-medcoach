{
  "name": "auricrx-medcoach",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "make-env-example": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-env-example.ps1",
    "validate:i18n": "node scripts/validate-i18n.js",
    "lint:i18n": "node scripts/validate-i18n.js",
    "test:i18n": "node scripts/check-i18n-locale-parity.cjs && node scripts/check-hardcoded-jsx-strings.cjs && node scripts/check-i18n.cjs",
    "test:i18n:parity": "node scripts/check-i18n-locale-parity.cjs",
    "test:i18n:hardcoded": "node scripts/check-hardcoded-jsx-strings.cjs",
    "check:compliance-terms": "node scripts/check-compliance-terms.js",
    "start:doctor": "npm --prefix apps/doctor start",
    "test:doctor-core": "jest --testPathPattern=doctor",
    "test:firestore-rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-auricrx-rules --config firebase.json 'npm --prefix tests/firestore-rules test'"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.1.0",
    "@neondatabase/serverless": "^1.0.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
