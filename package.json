    "jest-expo": "~53.0.14",
    "metro": "^0.82.5",
    "metro-config": "^0.82.5",
    "metro-resolver": "^0.82.5",
    "pdfkit": "^0.17.2",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition",
          "@react-native-masked-view/masked-view",
          "pdf-lib"
        ],
        "listUnknownPackages": false
