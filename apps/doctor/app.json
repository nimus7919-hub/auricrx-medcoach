{
  "expo": {
    "name": "AuricRX Médicos",
    "slug": "auricrx-doctors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080E1B"
    },
    "scheme": [
      "auricrx-doctors",
      "com.auricrx.doctors"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auricrx.doctors",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Desbloquea AuricRX Médicos después de iniciar sesión con la autenticación en dos pasos.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es",
          "en"
        ]
      },
      "buildNumber": "7"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080E1B"
      },
      "package": "com.auricrx.doctors",
      "versionCode": 2,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Desbloquea AuricRX Médicos después de iniciar sesión con la autenticación en dos pasos."
        }
      ],
      "expo-updates"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "firebaseNote": "Same Firebase project auricrx-medcoach, named database auricrxmedcoach. Apps registered for com.auricrx.doctors.",
      "eas": {
        "projectId": "d8a48be8-b7f0-44cb-a4e0-aa18f36ddccc"
      }
    },
    "owner": "firef1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d8a48be8-b7f0-44cb-a4e0-aa18f36ddccc"
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
