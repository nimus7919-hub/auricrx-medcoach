# Server Environment Variables Example
# Copy this to .env and fill in your values

# OpenAI API (for AI features)
OPENAI_API_KEY=your-openai-api-key
MODEL=gpt-4o-mini

# Server Port
PORT=4000

# Neon Database
DATABASE_URL=your-neon-database-url

# Firebase Admin (choose ONE method)
# Method 1: Individual credentials (from Render)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Method 2: Full JSON service account
# FIREBASE_SERVICE_ACCOUNT=

# Trial & Subscription (REQUIRED)
IDENTITY_HASH_SALT=your-random-64-character-hex-string

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
