OPENAI_API_KEY=YOUR_OPENAI_API_KEY
MODEL=YOUR_MODEL_NAME
PORT=YOUR_SERVER_PORT
DATABASE_URL=YOUR_DATABASE_URL
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
# Web API key for doctor MFA recovery (password proof via Identity Toolkit). Public client key is fine.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
IDENTITY_HASH_SALT=YOUR_IDENTITY_HASH_SALT

# Doctor verification / MFA (optional; leave unset in production unless needed)
# DOCTOR_ALLOW_MOCK_VERIFICATION must stay unset/false in production (fail-closed).
# DOCTOR_ALLOW_MOCK_VERIFICATION=false
# DOCTOR_MOCK_GRANTS=false
# DOCTOR_IDENTITY_PROVIDER=
# DOCTOR_AI_SUMMARY_MODEL=gpt-4o-mini
# DOCTOR_AI_API_KEY=
# DOCTOR_CALENDAR_OAUTH=false
# TRUORA_API_KEY=
# METAMAP_CLIENT_ID=
# METAMAP_CLIENT_SECRET=
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=

# Pre-visit AI intake (descriptive only). Off by default. Mock provider is the default.
# Do not put real key values in this file.
PREVISIT_INTAKE_ENABLED=false
PREVISIT_INTAKE_PROVIDER=mock
# Optional override of the single retention constant (days after appointment start). Default 30.
# PREVISIT_INTAKE_RAW_CHAT_RETENTION_DAYS=30
# To use the optional OpenAI interviewer instead of the mock (still filtered + template fallback):
# PREVISIT_INTAKE_PROVIDER=openai
# Reuses OPENAI_API_KEY or DOCTOR_AI_API_KEY (never log these values).
# PREVISIT_INTAKE_MODEL=gpt-4o-mini
# Optional secret for POST /api/internal/intake/purge
# PREVISIT_INTAKE_PURGE_SECRET=YOUR_PREVISIT_INTAKE_PURGE_SECRET
