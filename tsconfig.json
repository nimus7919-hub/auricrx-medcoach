{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/backup_*/**",
    "backup/**",
    "indautor Req/**",
    "android/**",
    "ios/**",
    "**/*_backup.tsx",
    "auric-rx/**",
    "app/**",
    "apps/doctor/**",
    "components/**",
    "dist-android-export/**",
    "**/__tests__/**",
    "tailwind.config.ts",
    ".health-connect-check/**",
    "src/components/DocumentsCard.tsx",
    "src/components/DocumentsCard.web.tsx"
  ],
  "extends": "expo/tsconfig.base"
}
