{
  "expo": {
    "name": "AuricRX MedCoach",
    "slug": "auricrx-medcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-auric.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1019"
    },
    "scheme": [
      "auricrx-medcoach",
      "com.auricrx.medcoach"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auricrx.medcoach",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para guardar lugares y consultar el pronóstico aproximado.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permite detectar entradas y salidas de tus lugares para enviarte recordatorios aunque la app esté cerrada.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "location",
          "fetch"
        ]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-auric.png",
        "backgroundColor": "#0d1019"
      },
      "package": "com.auricrx.medcoach",
      "googleServicesFile": "./android/app/google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DUMP",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DUMP",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withHealthConnect",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1043512593259-psqc8dqa2d4krptqfp4avhgejnkhamt1"
        }
      ],
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders-v2",
          "icon": "./assets/notification-icon-auric.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para guardar lugares y consultar el pronóstico aproximado.",
          "locationAlwaysAndWhenInUsePermission": "Permite detectar entradas y salidas de tus lugares para recordatorios aunque la app esté cerrada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-background-fetch"
    ],
    "extra": {
      "googleAuth": {
        "iosClientId": "1043512593259-psqc8dqa2d4krptqfp4avhgejnkhamt1.apps.googleusercontent.com",
        "androidClientId": "1043512593259-4mrlc7bm03354lo0m96aub399e6fqpe8.apps.googleusercontent.com",
        "webClientId": "1043512593259-mkpcv9c0boht5j478n3eaamo87fl4i8d.apps.googleusercontent.com",
        "redirectScheme": "auricrx-medcoach",
        "redirectPath": "auth"
      },
      "eas": {
        "projectId": "db976ea9-7756-4bdb-ba4e-7563b0d3597b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db976ea9-7756-4bdb-ba4e-7563b0d3597b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
