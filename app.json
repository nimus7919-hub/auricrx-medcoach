{
  "expo": {
    "name": "AuricRX MedCoach",
    "slug": "auricrx-medcoach",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-auric.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1019"
    },
    "scheme": [
      "auricrx-medcoach",
      "com.auricrx.medcoach"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auricrx.medcoach",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to save places and show the approximate weather forecast.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allows detecting arrivals and departures at your places so we can send you reminders even when the app is closed.",
        "NSFaceIDUsageDescription": "AuricRX MedCoach uses Face ID to unlock your Documents vault on this device.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-auric.png",
        "backgroundColor": "#0d1019"
      },
      "package": "com.auricrx.medcoach",
      "versionCode": 11,
      "googleServicesFile": "./android/app/google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DUMP",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DUMP",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "runtimeVersion": "1.1.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withHealthConnect",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1043512593259-psqc8dqa2d4krptqfp4avhgejnkhamt1"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders-v2",
          "icon": "./assets/notification-icon-auric.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to save places and show the approximate weather forecast.",
          "locationAlwaysAndWhenInUsePermission": "Allows detecting arrivals and departures at your places so we can send you reminders even when the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-background-fetch",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "We use the camera to take photos of prescriptions and documents that you choose to save.",
          "microphonePermission": "AuricRX only uses the microphone if you turn it on; it does not record audio in the background.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allows choosing photos of prescriptions or documents to save in the app.",
          "cameraPermission": "We use the camera to take photos of prescriptions and documents that you choose to save.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allows adding your appointments and reminders to your calendar.",
          "remindersPermission": "Allows creating reminders for your medications and appointments."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AuricRX MedCoach uses Face ID to unlock your Documents vault on this device."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "./plugins/withIosFirebaseStatic"
    ],
    "extra": {
      "googleAuth": {
        "iosClientId": "1043512593259-psqc8dqa2d4krptqfp4avhgejnkhamt1.apps.googleusercontent.com",
        "androidClientId": "1043512593259-4mrlc7bm03354lo0m96aub399e6fqpe8.apps.googleusercontent.com",
        "webClientId": "1043512593259-mkpcv9c0boht5j478n3eaamo87fl4i8d.apps.googleusercontent.com",
        "redirectScheme": "auricrx-medcoach",
        "redirectPath": "auth"
      },
      "eas": {
        "projectId": "db976ea9-7756-4bdb-ba4e-7563b0d3597b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db976ea9-7756-4bdb-ba4e-7563b0d3597b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    }
  }
}
