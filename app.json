{
  "expo": {
    "name": "AuricRx MedCoach",
    "slug": "auricrx-medcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/auricrx-logo.png",
    "scheme": "auricrx-medcoach",
    "splash": {
      "image": "./assets/auricrx-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1117"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/auricrx-logo.png",
        "backgroundColor": "#0b1117"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",        // Android 13+
        "android.permission.READ_EXTERNAL_STORAGE",    // pre-Android 13
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.auricrx.medcoach"
    },
    "web": { "favicon": "./assets/auricrx-logo.png" },
    "plugins": [
      "@react-native-voice/voice",
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "useAndroidX": true,
            "gradleProperties": {
              "android.useAndroidX": "true",
              "android.enableJetifier": "true"
            }
          }
        }
      ],
      "./app.plugin.js"
    ],
    "extra": {
      "eas": { "projectId": "db976ea9-7756-4bdb-ba4e-7563b0d3597b" }
    }
  }
}
